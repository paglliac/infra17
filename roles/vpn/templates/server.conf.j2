{#
  The clients' traffic goes out through vpn_uplink as the host's own tunnel address (the NL server knows no
  other). MSS is clamped to the clients' MTU both ways: TCP from a router's LAN arrives with MSS for 1500, and
  path MTU discovery across two tunnels is not something to count on.
#}
# {{ ansible_managed }}
[Interface]
Address = {{ vpn.net }}.1/24
ListenPort = {{ vpn.port }}
PrivateKey = {{ vpn_keys['server.key'] }}
MTU = {{ vpn_mtu }}
{% for line in vpn_params %}
{{ line }}
{% endfor %}
PostUp = iptables -t nat -A POSTROUTING -s {{ vpn.net }}.0/24 -o {{ vpn_uplink }} -j MASQUERADE
PostUp = iptables -t mangle -A FORWARD -i %i -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --set-mss {{ vpn_mtu - 40 }}
PostUp = iptables -t mangle -A FORWARD -o %i -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --set-mss {{ vpn_mtu - 40 }}
PreDown = iptables -t nat -D POSTROUTING -s {{ vpn.net }}.0/24 -o {{ vpn_uplink }} -j MASQUERADE || true
PreDown = iptables -t mangle -D FORWARD -i %i -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --set-mss {{ vpn_mtu - 40 }} || true
PreDown = iptables -t mangle -D FORWARD -o %i -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --set-mss {{ vpn_mtu - 40 }} || true
{% for name, octet in vpn.clients.items() %}

[Peer]
# {{ name }}
PublicKey = {{ vpn_keys[name ~ '.pub'] }}
PresharedKey = {{ vpn_keys[name ~ '.psk'] }}
AllowedIPs = {{ vpn.net }}.{{ octet }}/32
{% endfor %}
